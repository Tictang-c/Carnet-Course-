function shuffle(a) { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function generate(o) {
  const recent = new Set(mine(S.logs).filter(l => l.date > addDays(today(), -10)).flatMap(l => (l.items || []).map(i => i.ex)));
  const okMat = e => (e.mat || ['Sans matériel']).every(m => o.mats.includes(m) || m === 'Sans matériel');
  let pool = allEx().filter(e => e.fam === o.fam && (!o.subs.length || o.subs.includes(e.sub)) && okMat(e));
  if (o.avoid && pool.filter(e => !recent.has(e.id)).length >= o.n) pool = pool.filter(e => !recent.has(e.id));
  const bySub = {}; shuffle(pool).forEach(e => (bySub[e.sub] = bySub[e.sub] || []).push(e));
  const picks = []; const keys = Object.keys(bySub);
  while (picks.length < o.n && keys.some(k => bySub[k].length)) keys.forEach(k => { if (picks.length < o.n && bySub[k].length) picks.push(bySub[k].shift()); });
  let warm = [];
  if (o.warm) warm = shuffle(allEx().filter(e => ['Mobilité', 'Activation'].includes(e.fam) && okMat(e) && e.fam !== o.fam)).slice(0, 2);
  const items = warm.concat(picks).map(e => ({ ex: e.id, variant: '', sets: '', reps: '', load: '', rest: '', note: e.dose || '' }));
  draft = { id: null, name: `${o.fam} ${o.subs.length ? o.subs.join(' + ') : 'mixte'} – ${fmtDate(today())}`, fam: o.fam, dur: '', warm: '', cool: '', notes: 'Séance générée automatiquement', items };
}
