function sessText(s, src) {
  const lines = [`${s.title || s.name}${s.dur ? ' (' + s.dur + ')' : ''}`, s.warm ? `Échauffement : ${s.warm}` : ''];
  sessItems(s, src).forEach((i, k) => { const e = exById(i.ex) || { name: '?' }; lines.push(`${k + 1}. ${e.name}${i.variant ? ' (' + i.variant + ')' : ''} — ${[i.sets && i.reps ? i.sets + ' × ' + i.reps : '', i.load, i.rest ? 'récup ' + i.rest : '', i.note].filter(Boolean).join(' · ')}`); });
  if (s.cool) lines.push(`Retour au calme : ${s.cool}`);
