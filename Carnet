  if (a === 'close-bg' && ev.target !== t) return;
  if (a === 'close' || a === 'close-bg') { closeModal(); logDraft = null; return; }
  switch (a) {
    case 'f-fam': filt.fam = t.dataset.v; filt.sub = ''; render(); break;
    case 'f-sub': filt.sub = t.dataset.v; render(); break;
    case 'f-mat': filt.mat = t.dataset.v; render(); break;
    case 's-fam': sessFam = t.dataset.v; render(); break;
    case 'j-fam': journalFam = t.dataset.v; render(); break;
    case 'suivi-tab': suiviTab = t.dataset.v; render(); break;
    case 'wk': weekOff = t.dataset.v === '0' ? 0 : weekOff + +t.dataset.v; render(); break;
    case 'ex-open': exDetail(id); break;
    case 'ex-new': exForm(); break;
    case 'ex-edit': exForm(S.custom.find(c => c.id === id)); break;
    case 'ex-del': S.custom = S.custom.filter(c => c.id !== id); saveProfile(); closeModal(); render(); toast('Exercice supprimé'); break;
    case 'ex-prog': progEx = id; suiviTab = 'progression'; closeModal(); location.hash = 'suivi'; render(); break;
    case 'var-add': { const v = document.getElementById('var-in').value.trim(); if (!v) return; S.variants[id] = [...new Set([...(S.variants[id] || []), v])]; saveProfile(); exDetail(id); toast('Variante ajoutée'); break; }
    case 'var-del': S.variants[id] = (S.variants[id] || []).filter(x => x !== t.dataset.v); saveProfile(); exDetail(id); break;
    case 'photo-del': { const old = S.photos[id]; delete S.photos[id]; saveProfile(); try { if (assets && old) await assets.delete(old); } catch { } exDetail(id); toast('Photo retirée'); break; }
    case 'ex-to-draft': draft.items.push({ ex: id, variant: '', sets: '', reps: '', load: '', rest: '', note: (exById(id) || {}).dose || '' }); closeModal(); toast('Ajouté à la séance en construction'); break;
    case 'go-build': draft = newDraft(); location.hash = 'construire'; break;
    case 'sess-edit': { const s = findSession(id, t.dataset.src);
      draft = t.dataset.src === 'mine' ? JSON.parse(JSON.stringify(s)) : { id: null, name: s.title, fam: s.fam, dur: s.dur, warm: s.warm, cool: s.cool, notes: s.vig || '', items: sessItems(s, 'tpl') };
      location.hash = 'construire'; break; }
    case 'sess-dup': { const s = S.sessions.find(x => x.id === id); const c = JSON.parse(JSON.stringify(s)); c.id = uid(); c.name = s.name + ' (copie)'; c.updatedAt = Date.now(); await put('sessions', c.id, c); toast('Séance dupliquée'); break; }
    case 'sess-del': if (t.dataset.confirm !== '1') { t.dataset.confirm = '1'; t.textContent = 'Confirmer ?'; return; } await del('sessions', id); toast('Séance supprimée'); break;
    case 'sess-text': { const txt = sessText(findSession(id, t.dataset.src), t.dataset.src); try { await navigator.clipboard.writeText(txt); toast('Séance copiée : colle-la dans un message'); } catch { openModal(`<div class="stack">${head('Texte de la séance')}<textarea class="input" style="min-height:240px">${esc(txt)}</textarea></div>`); } break; }
    case 'draft-reset': draft = newDraft(); render(); break;
    case 'draft-save': case 'draft-live': {
      if (!draft.name.trim()) { if (a === 'draft-live') draft.name = 'Séance du ' + fmtDate(today()); else { toast('Donne un nom à la séance'); document.getElementById('d-name').focus(); return; } }
      if (!draft.id) draft.id = uid(); draft.updatedAt = Date.now();
      await put('sessions', draft.id, draft); toast('Séance enregistrée');
      if (a === 'draft-live') { live = buildLive(JSON.parse(JSON.stringify(draft)), 'mine'); startTick(); location.hash = 'direct'; }
      break; }
    case 'pick-open': openPicker(null); break;
    case 'p-fam': picker.f.fam = t.dataset.v; picker.f.sub = ''; renderPicker(); break;
    case 'p-toggle':
      if (picker.swap != null) { const it = draft.items[picker.swap]; it.ex = id; it.variant = ''; it.note = (exById(id) || {}).dose || ''; closeModal(); render(); toast('Exercice remplacé'); return; }
      picker.sel = picker.sel.includes(id) ? picker.sel.filter(x => x !== id) : picker.sel.concat(id); renderPicker(); break;
    case 'pick-add': picker.sel.forEach(x => draft.items.push({ ex: x, variant: '', sets: '', reps: '', load: '', rest: '', note: (exById(x) || {}).dose || '' })); closeModal(); render(); break;
    case 'it-del': draft.items.splice(+t.dataset.i, 1); render(); break;
    case 'it-up': case 'it-down': { const i = +t.dataset.i, j = a === 'it-up' ? i - 1 : i + 1; if (j < 0 || j >= draft.items.length) return; [draft.items[i], draft.items[j]] = [draft.items[j], draft.items[i]]; render(); break; }
    case 'it-swap': openPicker(+t.dataset.i); break;
    case 'gen-open': genOpen(); break;
    /* planning */
    case 'plan-add': window._planDate = t.dataset.date; sessionPicker(`Planifier le ${fmtDate(t.dataset.date)}`, 'plan-pick'); break;
    case 'plan-sess': window._planSess = { id, src: t.dataset.src }; openModal(`<form class="stack" id="plan-form">${head('Planifier la séance')}<label class="f" style="max-width:220px">Date<input class="input" type="date" id="pl-date" value="${today()}"></label><button class="btn" type="submit">Ajouter au planning</button></form>`); break;
    case 'plan-pick': { const s = findSession(id, t.dataset.src); await put('plans', uid(), { ath, date: window._planDate, sessionId: id, src: t.dataset.src, title: s.title || s.name, fam: s.fam }); closeModal(); toast('Séance planifiée'); break; }
    case 'plan-del': await del('plans', id); break;
    case 'wk-copy': { const start = addDays(weekKey(today()), weekOff * 7); const prev = mine(S.plans).filter(p => p.date >= addDays(start, -7) && p.date < start);
      if (!prev.length) { toast('Rien à copier la semaine précédente'); return; }
      for (const p of prev) await put('plans', uid(), { ath, date: addDays(p.date, 7), sessionId: p.sessionId, src: p.src, title: p.title, fam: p.fam });
      toast(`${prev.length} séance${prev.length > 1 ? 's' : ''} copiée${prev.length > 1 ? 's' : ''}`); break; }
    /* direct */
    case 'live-start': { const s = findSession(id, t.dataset.src); if (!s) return; live = buildLive(s, t.dataset.src, t.dataset.plan); startTick(); closeModal(); location.hash = 'direct'; render();
      try { navigator.wakeLock && (live.lock = await navigator.wakeLock.request('screen')); } catch { } break; }
    case 'live-next': live.idx++; live.rest = null; render(); window.scrollTo(0, 0); break;
    case 'live-prev': live.idx = Math.max(-1, live.idx - 1); live.rest = null; render(); window.scrollTo(0, 0); break;
    case 'live-quit': if (t.dataset.confirm !== '1') { t.dataset.confirm = '1'; t.textContent = 'Confirmer l’abandon ?'; return; } live = null; clearInterval(tick); location.hash = 'seances'; break;
    case 'live-finish': finishLive(); break;
    case 'set-tog': { const it = live.items[live.idx]; const s = it.sets[+t.dataset.k]; s.done = !s.done;
      if (s.done && it.sets.some(x => !x.done)) { live.rest = { end: Date.now() + it.rest * 1000 }; try { audio = audio || new (window.AudioContext || window.webkitAudioContext)(); } catch { } }
      render(); break; }
    case 'set-add': { const it = live.items[live.idx]; const l = it.sets[it.sets.length - 1]; it.sets.push({ done: false, reps: l.reps, load: l.load, time: '' }); render(); break; }
    case 'set-rem': live.items[live.idx].sets.pop(); render(); break;
    case 'rest-go': live.rest = { end: Date.now() + live.items[live.idx].rest * 1000 }; try { audio = audio || new (window.AudioContext || window.webkitAudioContext)(); } catch { } render(); break;
    case 'rest-stop': live.rest = null; render(); break;
    case 'rest-adj': { const it = live.items[live.idx]; it.rest = Math.max(5, it.rest + +t.dataset.v); if (live.rest) live.rest.end += +t.dataset.v * 1000; render(); break; }
    /* journal */
    case 'log-new': sessionPicker('Quelle séance as-tu faite ?', 'log-start', '<button class="btn ghost" data-a="log-free">Séance libre (sans modèle)</button>'); break;
    case 'log-free': logDraft = { id: null, ath, sessionId: null, sessionName: 'Séance libre', fam: 'Course', date: today(), duration: '', rpe: '', feel: '', notes: '', dist: '', dplus: '', fc: '', items: [] }; openLogForm(); break;
    case 'log-start': { const s = findSession(id, t.dataset.src); if (s) startLog(s, t.dataset.src, t.dataset.plan); break; }
    case 'log-view': { const l = S.logs.find(x => x.id === id); logDraft = JSON.parse(JSON.stringify(l)); logDraft.items = logDraft.items || []; openLogForm(); break; }
    case 'log-addex': { window._logAdd = true; const keep = logDraft; picker = { sel: [], swap: null, f: { q: '', fam: '', sub: '', mat: '' }, forLog: true };
      openModal(`<div class="stack">${head('Ajouter des exercices à la séance', '<button class="btn sm" data-a="pick-log">Ajouter</button>')}<input class="input" id="pq" placeholder="Chercher…"><div id="pick-body" class="stack"></div></div>`); logDraft = keep; renderPicker(); break; }
    case 'pick-log': { picker.sel.forEach(x => logDraft.items.push({ ex: x, variant: '', planned: '', sets: '', reps: '', load: '', times: '', rpe: '', note: '' })); picker = null; openLogForm(); break; }
    case 'log-del': if (t.dataset.confirm !== '1') { t.dataset.confirm = '1'; t.textContent = 'Confirmer la suppression ?'; return; }
      { const L = logDraft; await del('logs', L.id); const p = S.plans.find(x => x.logId === L.id); if (p) await put('plans', p.id, { ...p, logId: null }); logDraft = null; closeModal(); toast('Entrée supprimée'); } break;
    /* forme */
    case 'w-zone': { const z = t.dataset.v; wellDraft.pain = (wellDraft.pain || []).includes(z) ? wellDraft.pain.filter(x => x !== z) : (wellDraft.pain || []).concat(z); if (!wellDraft.painLvl && wellDraft.pain.length) wellDraft.painLvl = 3; render(); break; }
    case 'w-save': await put('well', ath + '_' + wellDraft.date, { ...wellDraft, ath }); toast('Forme du jour enregistrée'); break;
    /* tests */
    case 'test-new': testForm(t.dataset.v); break;
    case 'test-view': testForm(null, S.tests.find(x => x.id === id)); break;
    case 'tr-add': { const r = window._test.d.rows; r.push({ load: (num(r[r.length - 1] && r[r.length - 1].load) || 0) + 20, h: '' }); renderTest(); break; }
    case 'tr-del': window._test.d.rows.splice(+t.dataset.v, 1); renderTest(); break;
    case 'test-del': if (t.dataset.confirm !== '1') { t.dataset.confirm = '1'; t.textContent = 'Confirmer ?'; return; } await del('tests', window._test.id); closeModal(); toast('Test supprimé'); break;
    /* pratiquants */
    case 'ath-manage': athManage(); break;
    case 'ath-add': { const n = document.getElementById('ath-new').value.trim(); if (!n) return; const a2 = { id: 'a' + uid(), name: n }; S.athletes = S.athletes.concat([a2]); saveProfile(); ath = a2.id; try { localStorage.setItem('carnet-ath', ath); } catch { } athManage(); render(); break; }
    case 'ath-ren': { const n = document.getElementById('an-' + id).value.trim(); if (!n) return; S.athletes = S.athletes.map(x => x.id === id ? { ...x, name: n } : x); saveProfile(); toast('Renommé'); render(); break; }
    case 'ath-del': if (t.dataset.confirm !== '1') { t.dataset.confirm = '1'; t.textContent = 'Confirmer ?'; return; } S.athletes = S.athletes.filter(x => x.id !== id); if (ath === id) ath = 'moi'; saveProfile(); athManage(); render(); break;
    /* sauvegarde */
    case 'export': { const ph = {}; Object.values(S.photos).forEach(p => { if (PHOTO[p]) ph[p] = PHOTO[p]; });
      const data = JSON.stringify({ v: 2, custom: S.custom, variants: S.variants, photos: S.photos, photoData: ph, athletes: S.athletes, sessions: S.sessions, logs: S.logs, plans: S.plans, well: S.well, tests: S.tests });
      const a2 = document.createElement('a'); a2.href = URL.createObjectURL(new Blob([data], { type: 'application/json' })); a2.download = `carnet-sauvegarde-${today()}.json`; document.body.appendChild(a2); a2.click(); a2.remove();
      try { localStorage.setItem(KEY + '-lastexport', today()); } catch { } toast('Sauvegarde téléchargée'); render(); break; }
    case 'import': openModal(`<form class="stack" id="imp-form">${head('Restaurer une sauvegarde')}<div class="muted">Choisis un fichier de sauvegarde (.json) téléchargé depuis le carnet. Les éléments de même identifiant sont remplacés, le reste est conservé.</div><input type="file" id="imp-file" accept=".json,application/json" class="input"><button class="btn" type="submit">Restaurer</button></form>`); break;
  }
});
document.addEventListener('input', ev => {
  const t = ev.target;
  if (t.id === 'q') { filt.q = t.value; render(); return; }
  if (t.id === 'pq' && picker) { picker.f.q = t.value; renderPicker(); return; }
  if (t.id === 'sq') { renderSessPicker(t.value); return; }
  if (t.dataset.d) { draft[t.dataset.d] = t.value; return; }
  if (t.dataset.k && t.dataset.i != null && t.dataset.li == null) { draft.items[+t.dataset.i][t.dataset.k] = t.value; return; }
  if (t.dataset.li != null && logDraft) { logDraft.items[+t.dataset.li][t.dataset.k] = t.value; return; }
  if (t.dataset.l && logDraft) { logDraft[t.dataset.l] = t.value; const el = document.getElementById('lg-load'); if (el) el.textContent = loadOf(logDraft) || 0; return; }
  if (t.dataset.ls != null && live) { live.items[live.idx].sets[+t.dataset.ls][t.dataset.f] = t.value; return; }
  if (t.dataset.w && wellDraft) { wellDraft[t.dataset.w] = t.value; const b = t.parentElement.querySelector('b'); if (b) b.textContent = t.value; return; }
  if (window._test && t.closest('#test-form')) { const T = window._test;
    if (t.dataset.tdate) T.date = t.value; else if (t.dataset.t) T.d[t.dataset.t] = t.value; else if (t.dataset.tr != null) T.d.rows[+t.dataset.tr][t.dataset.f] = t.value;
    if (T.type === 'fv') { const r = fvCompute(T.d); const box = document.getElementById('fv-res'); if (box) box.innerHTML = r && r.F0 ? `<div class="kpis"><div class="kpi"><b>${r.F0.toFixed(1)}</b><span>F0 (N/kg)</span></div><div class="kpi"><b>${r.V0.toFixed(2)}</b><span>V0 (m/s)</span></div><div class="kpi"><b>${r.Pmax.toFixed(1)}</b><span>Pmax (W/kg)</span></div><div class="kpi"><b>${r.Sfv.toFixed(1)}</b><span>SFv</span></div><div class="kpi"><b>${r.r2.toFixed(3)}</b><span>R²</span></div></div>${fvChart(r)}` : '<div class="muted">Renseigne masse, hpo et au moins 2 hauteurs.</div>'; } }
});
document.addEventListener('change', async ev => {
  const t = ev.target;
  if (t.id === 'ath-sel') { ath = t.value; try { localStorage.setItem('carnet-ath', ath); } catch { } wellDraft = null; render(); return; }
  if (t.id === 'prog-sel') { progEx = t.value; render(); return; }
  if (t.id === 'photo-in' && t.files[0] && assets) {
    const exid = t.dataset.id; toast('Envoi de la photo…');
    try { const blob = await compress(t.files[0]); const r = await assets.upload(blob, { type: 'image/jpeg' }); const old = S.photos[exid]; S.photos[exid] = r.id; saveProfile(); try { if (old) await assets.delete(old); } catch { } exDetail(exid); render(); toast('Photo ajoutée'); }
    catch (e) { toast(e && e.code === 'too_large' ? 'Photo trop lourde.' : 'Envoi impossible, réessaie.'); }
    return; }
  if (t.dataset.li != null && logDraft) logDraft.items[+t.dataset.li][t.dataset.k] = t.value;
  else if (t.dataset.l && logDraft) { logDraft[t.dataset.l] = t.value; if (t.dataset.l === 'fam') renderLog(); }
  else if (t.dataset.d) draft[t.dataset.d] = t.value;
  else if (t.dataset.k && t.dataset.i != null) draft.items[+t.dataset.i][t.dataset.k] = t.value;
});
document.addEventListener('submit', async ev => {
  ev.preventDefault(); const f = ev.target;
  if (f.id === 'ex-form') {
    const v = id => document.getElementById(id).value.trim(); const name = v('e-name'); if (!name) return;
    const id = v('e-id') || 'u-' + uid();
    const e = { id, name, fam: v('e-fam'), sub: v('e-sub') || 'Perso', cons: v('e-cons'), dose: v('e-dose'), notes: v('e-notes'), var: v('e-var').split(',').map(s => s.trim()).filter(Boolean),
      mat: [...document.querySelectorAll('.e-mat:checked')].map(x => x.value), custom: true };
    if (!e.mat.length) e.mat = ['Sans matériel'];
    S.custom = S.custom.filter(c => c.id !== id).concat([e]); saveProfile(); closeModal(); render(); toast('Exercice enregistré');
  }
  if (f.id === 'log-form') {
    const L = logDraft; if (!L.id) L.id = uid(); L.ath = L.ath || ath; L.savedAt = Date.now();
    await put('logs', L.id, L);
    if (L.planId) { const p = S.plans.find(x => x.id === L.planId); if (p && p.logId !== L.id) await put('plans', p.id, { ...p, logId: L.id }); }
    logDraft = null; closeModal(); suiviTab = 'journal'; location.hash = 'suivi'; render(); toast('Séance ajoutée au journal');
  }
  if (f.id === 'gen-form') {
    generate({ fam: document.getElementById('g-fam').value, subs: [...document.getElementById('g-sub').selectedOptions].map(o => o.value), n: Math.max(2, Math.min(10, +document.getElementById('g-n').value || 5)),
      mats: [...document.querySelectorAll('.g-mat:checked')].map(x => x.value), warm: document.getElementById('g-warm').checked, avoid: document.getElementById('g-avoid').checked });
    closeModal(); location.hash = 'construire'; render(); toast('Séance générée : ajuste-la puis enregistre');
  }
  if (f.id === 'plan-form') { const s = findSession(window._planSess.id, window._planSess.src); await put('plans', uid(), { ath, date: document.getElementById('pl-date').value, sessionId: s.id, src: window._planSess.src, title: s.title || s.name, fam: s.fam }); closeModal(); toast('Séance planifiée'); }
  if (f.id === 'test-form') { const T = window._test; if (!T.id) T.id = uid(); T.ath = T.ath || ath; const d = T.d; let res = {};
    if (T.type === 'fv') { const r = fvCompute(d); if (r && r.F0) res = { F0: r.F0, V0: r.V0, Pmax: r.Pmax, Sfv: r.Sfv, r2: r.r2 }; }
    if (T.type === 'cmj') res = { best: Math.max(...[d.h1, d.h2, d.h3].map(num).filter(x => x != null), 0) || null };
    if (T.type === 'rsi') res = { rsi: num(d.h) && num(d.tc) ? (num(d.h) / 100) / (num(d.tc) / 1000) : null };
    T.res = res; await put('tests', T.id, T); closeModal(); suiviTab = 'tests'; render(); toast('Test enregistré'); }
  if (f.id === 'imp-form') {
    try { const fl = document.getElementById('imp-file').files[0]; if (!fl) { toast('Choisis un fichier'); return; } const d = JSON.parse(await fl.text());
      if (d.photoData) for (const [k, v] of Object.entries(d.photoData)) { PHOTO[k] = v; try { await idbPut(k, v); } catch { } }
      if (d.photos) Object.assign(S.photos, d.photos);
      if (Array.isArray(d.custom)) { const ids = new Set(d.custom.map(c => c.id)); S.custom = S.custom.filter(c => !ids.has(c.id)).concat(d.custom); }
      if (d.variants) Object.entries(d.variants).forEach(([k, v]) => S.variants[k] = [...new Set([...(S.variants[k] || []), ...v])]);
      if (Array.isArray(d.athletes)) d.athletes.forEach(a => { if (!S.athletes.some(x => x.id === a.id)) S.athletes.push(a); });
      saveProfile();
      for (const c of ['sessions', 'logs', 'plans', 'well', 'tests']) for (const x of d[c] || []) await put(c, x.id, x);
      closeModal(); render(); toast('Données restaurées');
    } catch { toast('Fichier illisible : choisis une sauvegarde du carnet.'); }
  }
});
function onHash() {
  const h = location.hash.slice(1);
  route = ['accueil', 'planning', 'seances', 'construire', 'direct', 'bibliotheque', 'suivi'].includes(h) ? h : 'accueil';
  if (route === 'direct' && !live) route = 'seances';
  render(); window.scrollTo(0, 0);
}
window.addEventListener('hashchange', onHash);
onHash();
initDb();
</script>
