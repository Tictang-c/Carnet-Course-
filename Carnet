<title>Carnet de séances course & trail</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  /* Carnet d'entraînement : onglets, cartes arrondies, une couleur par famille d'exercices, états en pastilles */
  --bg: #FBF8F4; --surface: #FFFFFF; --soft: #F3EFE9; --ink: #2B2D42; --muted: #6B7085; --line: #E6E1DA;
  --accent: #2B2D42; --ok: #12A150; --okbg: #DCF5E6; --warn: #C2410C; --warnbg: #FFEAD5; --bad: #B42318; --badbg: #FDE2E2;
  --display: 'Poppins', system-ui, sans-serif; --body: 'Inter', system-ui, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #17181F; --surface: #22232C; --soft: #2B2C36; --ink: #ECEDF3; --muted: #A2A6B8; --line: #383A46; --accent: #ECEDF3;
  --okbg: #16382A; --warnbg: #3D2716; --badbg: #3D1D1D; --ok: #4ADE80; --warn: #FB923C; --bad: #F87171; color-scheme: dark; } }
:root[data-theme="dark"] { --bg: #17181F; --surface: #22232C; --soft: #2B2C36; --ink: #ECEDF3; --muted: #A2A6B8; --line: #383A46; --accent: #ECEDF3;
  --okbg: #16382A; --warnbg: #3D2716; --badbg: #3D1D1D; --ok: #4ADE80; --warn: #FB923C; --bad: #F87171; color-scheme: dark; }
* { box-sizing: border-box; }
html, body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 15px; }
h1, h2, h3 { font-family: var(--display); margin: 0; text-wrap: balance; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 3px solid #7C5CFC; outline-offset: 2px; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 14px 16px 96px; }
header.top { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
header.top h1 { font-size: 21px; }
.who { display: flex; align-items: center; gap: 6px; }
.who select { border: 1.5px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 12px; font-weight: 600; }
.save { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
.save i { width: 8px; height: 8px; border-radius: 50%; background: var(--warn); display: inline-block; }
.save.ok i { background: var(--ok); }
nav.tabs { display: flex; gap: 4px; background: var(--surface); padding: 5px; border-radius: 999px; box-shadow: 0 2px 10px rgba(0,0,0,.06); margin-bottom: 16px; }
nav.tabs a { flex: 1; text-align: center; padding: 9px 8px; border-radius: 999px; text-decoration: none; color: var(--muted); font-family: var(--display); font-weight: 600; font-size: 14px; white-space: nowrap; }
nav.tabs a.on { background: var(--accent); color: var(--bg); }
@media (max-width: 700px) {
  nav.tabs { position: fixed; bottom: 10px; left: 10px; right: 10px; z-index: 40; margin: 0; box-shadow: 0 6px 24px rgba(0,0,0,.18); }
  nav.tabs a { font-size: 12px; padding: 10px 2px; }
}
.row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.between { justify-content: space-between; }
.chip { border: 0; border-radius: 999px; padding: 6px 12px; font-size: 13px; font-weight: 600; background: var(--soft); color: var(--ink); }
.chip.on { color: #fff; }
.btn { border: 0; border-radius: 14px; padding: 10px 16px; font-weight: 600; background: var(--accent); color: var(--bg); font-family: var(--display); font-size: 14px; }
.btn.ghost { background: var(--soft); color: var(--ink); }
.btn.sm { padding: 6px 11px; font-size: 13px; border-radius: 11px; }
.btn.lg { padding: 14px 20px; font-size: 16px; border-radius: 16px; }
.btn.danger { background: var(--badbg); color: var(--bad); }
.btn.go { background: var(--ok); color: #fff; }
.input, select.input, textarea.input { width: 100%; border: 1.5px solid var(--line); background: var(--surface); border-radius: 12px; padding: 9px 12px; }
textarea.input { min-height: 64px; resize: vertical; }
label.f { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 600; color: var(--muted); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
.card { background: var(--surface); border-radius: 20px; box-shadow: 0 2px 12px rgba(0,0,0,.05); padding: 14px; }
.ex { display: flex; flex-direction: column; gap: 8px; cursor: pointer; border: 2px solid transparent; text-align: left; }
.ex:hover { border-color: var(--line); }
.ill { border-radius: 14px; aspect-ratio: 13/10; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.ill svg { width: 100%; height: 100%; }
.ill img { width: 100%; height: 100%; object-fit: cover; }
.ill.wide { aspect-ratio: 5/2; }
.ill.wide svg { width: 96%; height: auto; }
.ex h3 { font-size: 14.5px; line-height: 1.25; }
.tag { display: inline-block; border-radius: 999px; padding: 3px 9px; font-size: 11px; font-weight: 700; letter-spacing: .03em; }
.tag.mat { background: var(--soft); color: var(--muted); font-weight: 600; }
.muted { color: var(--muted); font-size: 13px; line-height: 1.4; }
.dose { font-weight: 700; font-size: 12.5px; border-radius: 999px; padding: 4px 10px; display: inline-block; }
.section-title { font-size: 17px; margin: 20px 0 10px; display: flex; align-items: center; gap: 8px; }
.empty { text-align: center; padding: 24px 16px; color: var(--muted); background: var(--surface); border-radius: 20px; border: 2px dashed var(--line); }
.sess { display: flex; flex-direction: column; gap: 8px; border-left: 6px solid var(--line); }
.sess h3 { font-size: 15px; }
.minis { display: flex; gap: 4px; flex-wrap: wrap; }
.minis span { width: 34px; height: 26px; border-radius: 8px; overflow: hidden; display: inline-flex; }
.minis svg, .minis img { width: 100%; height: 100%; object-fit: cover; }
.wideprev { border-radius: 12px; padding: 4px; }
.wideprev svg { width: 100%; height: auto; display: block; }
.item { display: grid; grid-template-columns: 74px 1fr; gap: 12px; padding: 12px; border-radius: 18px; background: var(--soft); }
.item .ill { height: 60px; aspect-ratio: auto; }
.fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; margin-top: 8px; }
.fields .input { padding: 7px 9px; }
.last { font-size: 12px; color: var(--muted); margin-top: 4px; }
.last b { color: var(--ink); }
.stack { display: flex; flex-direction: column; gap: 10px; }
.modal-bg { position: fixed; inset: 0; background: rgba(20,20,30,.45); display: flex; align-items: flex-end; justify-content: center; z-index: 50; }
.modal { background: var(--bg); width: min(780px, 100%); max-height: 92%; overflow: auto; border-radius: 24px 24px 0 0; padding: 18px 16px 24px; }
@media (min-width: 700px) { .modal-bg { align-items: center; } .modal { border-radius: 24px; } }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.kpi { background: var(--surface); border-radius: 18px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; }
.kpi b { font-family: var(--display); font-size: 24px; font-variant-numeric: tabular-nums; }
.kpi span { font-size: 12px; color: var(--muted); }
.pill { display: inline-block; border-radius: 999px; padding: 2px 9px; font-size: 11.5px; font-weight: 700; }
.pill.ok { background: var(--okbg); color: var(--ok); } .pill.warn { background: var(--warnbg); color: var(--warn); } .pill.bad { background: var(--badbg); color: var(--bad); }
.alert { border-radius: 16px; padding: 11px 14px; font-size: 13.5px; display: flex; gap: 10px; align-items: flex-start; }
.alert.warn { background: var(--warnbg); color: var(--warn); } .alert.bad { background: var(--badbg); color: var(--bad); } .alert.ok { background: var(--okbg); color: var(--ok); }
.log { display: grid; grid-template-columns: 56px 1fr auto; gap: 12px; align-items: center; }
.date { text-align: center; border-radius: 14px; padding: 6px 0; font-family: var(--display); font-weight: 700; line-height: 1.1; }
.date small { display: block; font-size: 11px; font-weight: 600; }
.toast { position: fixed; bottom: 84px; left: 50%; transform: translateX(-50%); background: var(--accent); color: var(--bg); padding: 10px 18px; border-radius: 999px; font-weight: 600; z-index: 60; max-width: 90%; text-align: center; }
.note { background: #FFF6DE; color: #6B4E00; border-radius: 14px; padding: 10px 14px; font-size: 13px; }
.chart text { fill: var(--muted); font-size: 11px; font-family: var(--body); }
.subtabs { display: flex; gap: 6px; flex-wrap: wrap; }
.week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
@media (max-width: 760px) { .week { grid-template-columns: 1fr; } }
.day { background: var(--surface); border-radius: 16px; padding: 10px; min-height: 120px; display: flex; flex-direction: column; gap: 6px; }
.day.today { outline: 2.5px solid #7C5CFC; }
.day h4 { margin: 0; font-family: var(--display); font-size: 13px; display: flex; justify-content: space-between; }
.plan { border-radius: 12px; padding: 7px 9px; font-size: 12.5px; font-weight: 600; display: flex; flex-direction: column; gap: 4px; }
.plan.done { opacity: .75; }
.plan .row { gap: 4px; }
.slider { display: grid; grid-template-columns: 120px 1fr 28px; gap: 8px; align-items: center; font-size: 13px; }
.slider input { width: 100%; accent-color: #7C5CFC; }
.zones { display: flex; gap: 6px; flex-wrap: wrap; }
.live-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.bar { height: 8px; background: var(--soft); border-radius: 99px; overflow: hidden; }
.bar i { display: block; height: 100%; border-radius: 99px; }
.live-ill { max-width: 420px; margin: 0 auto; width: 100%; }
.setrow { display: grid; grid-template-columns: 44px 1fr 1fr 1fr; gap: 8px; align-items: center; background: var(--soft); border-radius: 14px; padding: 8px; }
.setrow.done { background: var(--okbg); }
.check { width: 40px; height: 40px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); font-weight: 700; font-size: 18px; }
.setrow.done .check { background: var(--ok); border-color: var(--ok); color: #fff; }
.timer { font-family: var(--display); font-size: 54px; font-weight: 700; text-align: center; font-variant-numeric: tabular-nums; line-height: 1; }
.timer.run { color: #7C5CFC; }
.timer.end { color: var(--ok); }
table.t { width: 100%; border-collapse: collapse; font-size: 13px; }
table.t td, table.t th { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; font-variant-numeric: tabular-nums; }
@media (max-width: 520px) { .item { grid-template-columns: 1fr; } .item .ill { height: 90px; } header.top h1 { font-size: 18px; } .slider { grid-template-columns: 96px 1fr 24px; } }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
