<script>
/* =========================================================== données */
const CAT = JSON.parse(document.getElementById('catalog').textContent);
const FAMS = Object.keys(CAT.fam);
const MATS = [...new Set(CAT.ex.flatMap(e => e.mat || []))];
const ZONES = ['Pied', 'Cheville / Achille', 'Mollet', 'Tibia', 'Genou', 'Ischios', 'Quadriceps', 'Hanche / adducteurs', 'Fessier', 'Bas du dos', 'Autre'];
const S = { custom: [], variants: {}, photos: {}, athletes: [{ id: 'moi', name: 'Moi' }], sessions: [], logs: [], plans: [], well: [], tests: [] };
let persist = null, assets = null; const PHOTO = {};
let route = 'accueil';
let ath = (() => { try { return localStorage.getItem('carnet-ath') || 'moi'; } catch { return 'moi'; } })();
let filt = { q: '', fam: '', sub: '', mat: '' };
let draft = newDraft();
let picker = null, logDraft = null, live = null, sessFam = '', suiviTab = 'charge', progEx = '', weekOff = 0, journalFam = '';
let wellDraft = null;

const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
const iso = d => { const z = new Date(d.getTime() - d.getTimezoneOffset() * 60000); return z.toISOString().slice(0, 10); };
const today = () => iso(new Date());
const addDays = (s, n) => { const d = new Date(s + 'T12:00:00'); d.setDate(d.getDate() + n); return iso(d); };
const MOIS = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'];
const JOURS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
function newDraft() { return { id: null, name: '', fam: 'Renforcement', dur: '', warm: '', cool: '', notes: '', items: [] }; }
function col(f, k = 'fam') { return (CAT[k] || {})[f] || (k === 'fam' ? '#8A8FA3' : k === 'tint' ? '#EEF0F4' : '#555A6E'); }
const mine = arr => arr.filter(x => (x.ath || 'moi') === ath);

function allEx() { return CAT.ex.concat(S.custom); }
function exById(id) { return allEx().find(e => e.id === id); }
function variantsOf(e) { return [...new Set([...(e.var || []), ...((S.variants[e.id]) || [])])]; }
function placeholder(e) {
  const ini = (e.name || '?').split(/\s+/).slice(0, 2).map(w => w[0] || '').join('').toUpperCase();
  return `<svg viewBox="0 0 130 100" xmlns="http://www.w3.org/2000/svg"><circle cx="65" cy="50" r="28" fill="${col(e.fam)}" opacity=".9"/><text x="65" y="58" text-anchor="middle" font-family="Poppins" font-weight="700" font-size="22" fill="#fff">${esc(ini)}</text></svg>`;
}
function visOf(e, preferPhoto = true) {
  const p = S.photos[e.id];
 if (p && preferPhoto && PHOTO[p]) return `<img src="${PHOTO[p]}" alt="${esc(e.name)}" onerror="this.replaceWith(document.createRange().createContextualFragment(this.dataset.fb))" data-fb="${esc(e.svg || placeholder(e))}">`;
  return e.svg || placeholder(e);
}

/* =========================================================== parsing doses */
function parseDose(txt) {
  txt = String(txt || '');
  const m = txt.match(/(\d+)\s*(?:à\s*\d+\s*)?[×x]\s*\(?([^•(]+?)(?:\)|\s*•|$)/);
  return m ? { sets: +m[1], reps: m[2].trim() } : { sets: 1, reps: txt.split('•')[0].trim() };
}
function parseRest(txt, fam) {
  const s = String(txt || '');
  let m = s.match(/(\d+)\s*min\s*(\d+)?/); if (m) return +m[1] * 60 + (+m[2] || 0);
  m = s.match(/(\d+)\s*[′']\s*(\d+)?/); if (m) return +m[1] * 60 + (+m[2] || 0);
  m = s.match(/(\d+)\s*s\b/); if (m) return +m[1];
  return fam === 'Course' ? 120 : fam === 'Renforcement' ? 90 : 20;
}
const num = s => { const m = String(s || '').replace(',', '.').match(/-?\d+(\.\d+)?/); return m ? +m[0] : null; };
function secs(s) { const m = String(s || '').match(/(\d+)[:'′](\d{1,2})/); return m ? +m[1] * 60 + +m[2] : (num(s) || null); }
const mmss = t => `${Math.floor(t / 60)}:${String(Math.round(t % 60)).padStart(2, '0')}`;

/* =========================================================== sauvegarde */
function setSave(ok, txt) { const el = document.getElementById('save'); el.classList.toggle('ok', ok); el.querySelector('span').textContent = txt; }
const KEY = 'carnet-seances-v2';
function saveLocal() {
  try { localStorage.setItem(KEY, JSON.stringify({ custom: S.custom, variants: S.variants, photos: S.photos, athletes: S.athletes, sessions: S.sessions, logs: S.logs, plans: S.plans, well: S.well, tests: S.tests }));
    setSave(true, 'Enregistré sur cet appareil'); }
  catch (e) { setSave(false, 'Stockage plein ou bloqué : exporte une sauvegarde'); }
}
function saveProfile() { saveLocal(); render(); }
async function put(colName, id, body) {
  body = JSON.parse(JSON.stringify(body)); body.id = id;
  S[colName] = S[colName].filter(x => x.id !== id).concat([body]); sortLocal(); saveLocal(); render();
}
async function del(colName, id) { S[colName] = S[colName].filter(x => x.id !== id); saveLocal(); render(); }
function sortLocal() { S.logs.sort((a, b) => (b.date || '').localeCompare(a.date || '')); }
function showErr() { toast('Échec de l’enregistrement.'); }
/* photos dans IndexedDB */
function idb() { return new Promise((res, rej) => { setTimeout(() => rej('timeout'), 3000); const r = indexedDB.open('carnet-photos', 1); r.onupgradeneeded = () => r.result.createObjectStore('p'); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); }); }
async function idbAll() { const db = await idb(); return new Promise(res => { const out = {}; const tx = db.transaction('p'); const st = tx.objectStore('p'); const c = st.openCursor(); c.onsuccess = () => { const cur = c.result; if (cur) { out[cur.key] = cur.value; cur.continue(); } else res(out); }; c.onerror = () => res(out); }); }
async function idbPut(k, v) { const db = await idb(); return new Promise((res, rej) => { const tx = db.transaction('p', 'readwrite'); tx.objectStore('p').put(v, k); tx.oncomplete = res; tx.onerror = () => rej(tx.error); }); }
async function idbDel(k) { const db = await idb(); return new Promise(res => { const tx = db.transaction('p', 'readwrite'); tx.objectStore('p').delete(k); tx.oncomplete = res; tx.onerror = res; }); }
const blobToUrl = b => new Promise(r => { const f = new FileReader(); f.onload = () => r(f.result); f.readAsDataURL(b); });
async function initDb() {
  try { const d = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (d) { ['custom', 'sessions', 'logs', 'plans', 'well', 'tests'].forEach(k => S[k] = d[k] || []); S.variants = d.variants || {}; S.photos = d.photos || {}; if (d.athletes && d.athletes.length) S.athletes = d.athletes; sortLocal(); }
    setSave(true, 'Enregistré sur cet appareil');
    try { navigator.storage && navigator.storage.persist && navigator.storage.persist(); } catch { }
  } catch { setSave(false, 'Stockage indisponible dans ce navigateur (navigation privée ?)'); }
  render();
  try { Object.assign(PHOTO, await idbAll());
    assets = { upload: async blob => { const id = 'ph' + uid(); PHOTO[id] = await blobToUrl(blob); await idbPut(id, PHOTO[id]); return { id }; }, delete: async id => { delete PHOTO[id]; await idbDel(id); } };
  } catch { assets = null; }
  render();
}

/* =========================================================== utilitaires UI */
function toast(t) { const d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.appendChild(d); setTimeout(() => d.remove(), 2800); }
function openModal(html) { document.getElementById('modal').innerHTML = `<div class="modal-bg" data-a="close-bg"><div class="modal" role="dialog" aria-modal="true">${html}</div></div>`; }
function closeModal() { document.getElementById('modal').innerHTML = ''; picker = null; }
const head = (t, extra = '') => `<div class="row between"><h2>${t}</h2><div class="row">${extra}<button type="button" class="btn sm ghost" data-a="close">Fermer</button></div></div>`;
function chips(list, cur, act, colorFn) {
  return list.map(([v, label]) => { const on = cur === v; const c = colorFn ? colorFn(v) : null;
    return `<button class="chip ${on ? 'on' : ''}" style="${on ? `background:${c || 'var(--accent)'};color:${c ? '#fff' : 'var(--bg)'}` : (c ? `color:${col(v, 'dark')}` : '')}" data-a="${act}" data-v="${esc(v)}">${esc(label)}</button>`; }).join('');
}
const famChips = (cur, act) => chips([['', 'Tout'], ...FAMS.map(f => [f, f])], cur, act, v => v ? col(v) : null);
function subsOf(fam) { return [...new Set(allEx().filter(e => !fam || e.fam === fam).map(e => e.sub))].filter(Boolean); }
function filtered(f) {
  const q = (f.q || '').trim().toLowerCase();
  return allEx().filter(e => (!f.fam || e.fam === f.fam) && (!f.sub || e.sub === f.sub) && (!f.mat || (e.mat || ['Sans matériel']).includes(f.mat)) &&
    (!q || (e.name + ' ' + e.sub + ' ' + (e.cons || '') + ' ' + variantsOf(e).join(' ')).toLowerCase().includes(q)));
}
function exCard(e, act = 'ex-open', sel = false) {
  return `<button class="card ex" data-a="${act}" data-id="${esc(e.id)}" style="${sel ? `border-color:${col(e.fam)}` : ''}">
    <div class="ill ${e.wide && !S.photos[e.id] ? 'wide' : ''}" style="background:${col(e.fam, 'tint')}">${visOf(e)}</div>
    <div class="row between"><span class="tag" style="background:${col(e.fam, 'tint')};color:${col(e.fam, 'dark')}">${esc(e.sub || e.fam)}</span>${sel ? `<span class="tag" style="background:${col(e.fam)};color:#fff">Choisi</span>` : ''}</div>
    <h3>${esc(e.name)}</h3>
    <div class="muted">${esc(e.cons || '')}</div>
    <div class="row">${e.dose ? `<span class="dose" style="background:${col(e.fam, 'tint')};color:${col(e.fam, 'dark')}">${esc(e.dose)}</span>` : ''}${(e.mat || []).filter(m => m !== 'Sans matériel').map(m => `<span class="tag mat">${esc(m)}</span>`).join('')}</div>
  </button>`;
}
function lastFor(exId, excludeLog) {
  for (const l of mine(S.logs)) { if (l.id === excludeLog) continue; const it = (l.items || []).find(i => i.ex === exId && (i.sets || i.reps || i.load || i.note || i.times)); if (it) return { l, it }; }
  return null;
}
function fmtDate(d) { if (!d) return ''; const [y, m, j] = d.split('-'); return `${j}/${m}/${y.slice(2)}`; }
function perf(it) { return [it.variant, (it.sets || it.reps) ? `${it.sets || '?'} × ${it.reps || '?'}` : '', it.load, it.times ? 'temps ' + it.times : '', it.rpe ? 'RPE ' + it.rpe : '', it.note].filter(Boolean).join(' · '); }
function findSession(id, src) { return src === 'mine' ? S.sessions.find(s => s.id === id) : CAT.tpl.find(s => s.id === id); }
function sessItems(s, src) { return (s.items || []).map(i => src === 'tpl' ? { ex: i.ex, variant: '', sets: '', reps: '', load: '', rest: '', note: i.dose || '' } : { ...i }); }

/* =========================================================== calculs de charge */
const loadOf = l => (+l.duration || 0) * (+l.rpe || 0);
function weekKey(dstr) { const d = new Date(dstr + 'T12:00:00'); const day = (d.getDay() + 6) % 7; d.setDate(d.getDate() - day); return iso(d); }
function metrics() {
  const logs = mine(S.logs); const t = today();
  const dayLoad = d => logs.filter(l => l.date === d).reduce((s, l) => s + loadOf(l), 0);
  const last7 = [...Array(7)].map((_, i) => dayLoad(addDays(t, -i)));
  const acute = last7.reduce((a, b) => a + b, 0);
  const chronic = [...Array(28)].map((_, i) => dayLoad(addDays(t, -i))).reduce((a, b) => a + b, 0) / 4;
  const mean = acute / 7; const sd = Math.sqrt(last7.reduce((s, x) => s + (x - mean) ** 2, 0) / 7);
  const mono = sd ? mean / sd : 0;
  const nbLogs28 = logs.filter(l => l.date > addDays(t, -28)).length;
  return { acute, chronic, acwr: chronic ? acute / chronic : null, mono, strain: acute * mono, n7: logs.filter(l => l.date > addDays(t, -7)).length, nbLogs28 };
}
function hooperOf(w) { return w ? (+w.sleep || 0) + (+w.fatigue || 0) + (+w.stress || 0) + (+w.doms || 0) : null; }
function alerts() {
  const m = metrics(), out = [];
  if (m.acwr != null && m.nbLogs28 >= 6) {
    if (m.acwr > 1.5) out.push(['bad', `Ratio aigu/chronique à ${m.acwr.toFixed(2)} : hausse de charge brutale, alléger les prochains jours.`]);
    else if (m.acwr > 1.3) out.push(['warn', `Ratio aigu/chronique à ${m.acwr.toFixed(2)} : au-dessus de la zone 0,8–1,3.`]);
    else if (m.acwr < 0.8) out.push(['warn', `Ratio aigu/chronique à ${m.acwr.toFixed(2)} : charge en baisse (normal en affûtage ou récupération).`]);
  }
  if (m.mono > 2) out.push(['warn', `Monotonie à ${m.mono.toFixed(1)} sur 7 jours : varier davantage les charges d’un jour à l’autre.`]);
  const w = mine(S.well).find(x => x.date === today());
  if (w) { const h = hooperOf(w);
    if (h >= 20 || [w.sleep, w.fatigue, w.stress, w.doms].some(v => +v >= 6)) out.push(['bad', `Indice de Hooper élevé (${h}/28) : adapter ou alléger la séance du jour.`]);
