}

/* =========================================================== graphiques SVG */
function lineChart(pts, { w = 520, h = 170, color = '#7C5CFC', yLabel = '', fmt = v => Math.round(v * 10) / 10, band = null } = {}) {
  if (!pts.length) return '<div class="muted">Pas encore de données.</div>';
  const ys = pts.map(p => p.y); let lo = Math.min(...ys), hi = Math.max(...ys);
  if (band) { lo = Math.min(lo, band[0]); hi = Math.max(hi, band[1]); }
  const pos = lo >= 0; if (lo === hi) { lo -= 1; hi += 1; } const pad = (hi - lo) * .12; lo -= pad; hi += pad; if (pos) lo = Math.max(0, lo);
  const L = 40, R = 14, T = 14, B = 26;
  const X = i => pts.length === 1 ? (L + w - R) / 2 : L + i * (w - L - R) / (pts.length - 1);
  const Y = v => T + (hi - v) * (h - T - B) / (hi - lo);
  const grid = [0, 1, 2, 3].map(k => { const v = lo + (hi - lo) * k / 3; return `<line x1="${L}" x2="${w - R}" y1="${Y(v)}" y2="${Y(v)}" stroke="var(--line)"/><text x="${L - 6}" y="${Y(v) + 4}" text-anchor="end">${fmt(v)}</text>`; }).join('');
  const bandR = band ? `<rect x="${L}" width="${w - L - R}" y="${Y(band[1])}" height="${Y(band[0]) - Y(band[1])}" fill="var(--okbg)" opacity=".8"/>` : '';
  const path = pts.map((p, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(p.y).toFixed(1)}`).join(' ');
  const area = pts.length > 1 ? `<path d="${path} L${X(pts.length - 1)} ${h - B} L${X(0)} ${h - B} Z" fill="${color}" opacity=".10"/>` : '';
  const step = Math.ceil(pts.length / 7);
  const labels = pts.map((p, i) => (i % step === 0 || i === pts.length - 1) ? `<text x="${X(i)}" y="${h - 8}" text-anchor="middle">${esc(p.label)}</text>` : '').join('');
  const dots = pts.map((p, i) => `<circle cx="${X(i)}" cy="${Y(p.y)}" r="${i === pts.length - 1 ? 5 : 3}" fill="${color}"><title>${esc(p.label)} : ${fmt(p.y)}</title></circle>`).join('');
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" width="100%">${bandR}${grid}${area}<path d="${path}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round"/>${dots}${labels}${yLabel ? `<text x="${L}" y="10">${esc(yLabel)}</text>` : ''}</svg>`;
}
function stackBars(weeks, series, { w = 860, h = 240 } = {}) {
  const tot = weeks.map((_, i) => series.reduce((s, se) => s + se.vals[i], 0)); const max = Math.max(...tot, 1);
  const L = 10, B = 26, T = 18, bw = (w - L * 2) / weeks.length;
  let out = '';
  weeks.forEach((wk, i) => { let y = h - B; const x = L + i * bw + bw * .18;
    series.forEach(se => { const v = se.vals[i]; if (!v) return; const hh = v / max * (h - B - T); y -= hh; out += `<rect x="${x}" y="${y}" width="${bw * .64}" height="${hh}" rx="4" fill="${se.color}"><title>${esc(se.name)} : ${v}</title></rect>`; });
    if (tot[i]) out += `<text x="${x + bw * .32}" y="${y - 4}" text-anchor="middle">${tot[i]}</text>`;
    const [, m, j] = wk.split('-'); out += `<text x="${x + bw * .32}" y="${h - 8}" text-anchor="middle">${j}/${m}</text>`; });
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" width="100%">${out}<line x1="${L}" x2="${w - L}" y1="${h - B + .5}" y2="${h - B + .5}" stroke="var(--line)" stroke-width="2"/></svg>`;
}

